@model SMS.Application.InvoiceDto

@{
    ViewData["Title"] = "Delete Invoice";
}

<h2>Delete Invoice</h2>

<div class="alert alert-warning">
    Are you sure you want to permanently delete this invoice?
</div>

<dl class="row">
    <dt class="col-sm-3">Invoice Number</dt>
    <dd class="col-sm-9">@Model.InvoiceNumber</dd>

    <dt class="col-sm-3">Tenant ID</dt>
    <dd class="col-sm-9">@Model.TenantId</dd>

    <dt class="col-sm-3">Total Amount</dt>
    <dd class="col-sm-9">@Model.TotalAmount.ToString("N2")</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.InvoiceId" method="post">
    @Html.AntiForgeryToken()

    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
