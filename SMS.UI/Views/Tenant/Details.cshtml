@model SMS.Application.TenantDto

@{
    ViewData["Title"] = "Tenant Details";
}

<h2>Tenant Details</h2>

<hr />

<dl class="row">
    <dt class="col-sm-3">Tenant ID</dt>
    <dd class="col-sm-9">@Model.TenantId</dd>

    <dt class="col-sm-3">Tenant Name</dt>
    <dd class="col-sm-9">@Model.TenantName</dd>

    <dt class="col-sm-3">Tenant Code</dt>
    <dd class="col-sm-9">@Model.TenantCode</dd>

    <dt class="col-sm-3">Address</dt>
    <dd class="col-sm-9">@Model.TenantAddress</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Phone Number</dt>
    <dd class="col-sm-9">@Model.PhoneNumber</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.TenantDescription</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">
        @(Model.IsActive ? "Active" : "Inactive")
    </dd>

    <dt class="col-sm-3">Created On</dt>
    <dd class="col-sm-9">@Model.CreatedOn</dd>

    <dt class="col-sm-3">Created By</dt>
    <dd class="col-sm-9">@Model.CreatedBy</dd>

    <dt class="col-sm-3">Modified On</dt>
    <dd class="col-sm-9">@Model.ModifyOn</dd>

    <dt class="col-sm-3">Modified By</dt>
    <dd class="col-sm-9">@Model.ModifyBy</dd>
</dl>

<a asp-action="Edit"
   asp-route-id="@Model.TenantId"
   class="btn btn-warning">Edit</a>

<a asp-action="Index" class="btn btn-secondary">Back</a>