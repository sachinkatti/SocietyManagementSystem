@model SMS.Application.ComplaintDto

@{
    ViewData["Title"] = "Delete Complaint";
}

<h2>Delete Complaint</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this complaint? It will be deactivated in the database rather than permanently deleted.
</div>

<dl class="row">
    <dt class="col-sm-3">Complaint ID</dt>
    <dd class="col-sm-9">@Model.ComplaintId</dd>

    <dt class="col-sm-3">Resident</dt>
    <dd class="col-sm-9">@Model.ResidentName</dd>

    <dt class="col-sm-3">Flat Number</dt>
    <dd class="col-sm-9">@Model.FlatNumber</dd>

    <dt class="col-sm-3">Category</dt>
    <dd class="col-sm-9">@Model.Category</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Description</dd>

    <dt class="col-sm-3">Priority</dt>
    <dd class="col-sm-9">@Model.Priority</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.ComplaintId" method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>