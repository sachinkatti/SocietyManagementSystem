@model SMS.Application.RegionDto

@{
    ViewData["Title"] = "Delete Region";
}

<h2>Delete Region</h2>

<h4>Are you sure you want to delete this region?</h4>

<div>
    <dl class="row">
        <dt class="col-sm-3">Region Code</dt>
        <dd class="col-sm-9">@Model.RegionCode</dd>

        <dt class="col-sm-3">Region Name</dt>
        <dd class="col-sm-9">@Model.RegionName</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Description</dd>
    </dl>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" name="regionId" value="@Model.RegionId" />

        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>