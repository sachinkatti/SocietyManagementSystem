@model SMS.Application.TenantSubscriptionDto

@{
    ViewData["Title"] = "Delete Subscription";
}

<h2>Delete Subscription</h2>

<p>Are you sure you want to deactivate this subscription?</p>

<dl class="row">
    <dt class="col-sm-3">Subscription ID</dt>
    <dd class="col-sm-9">@Model.SubscriptionId</dd>

    <dt class="col-sm-3">Tenant ID</dt>
    <dd class="col-sm-9">@Model.TenantId</dd>

    <dt class="col-sm-3">Plan ID</dt>
    <dd class="col-sm-9">@Model.PlanId</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>

    <dt class="col-sm-3">Amount Paid</dt>
    <dd class="col-sm-9">@Model.AmountPaid.ToString("N2")</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.SubscriptionId" method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Deactivate</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>