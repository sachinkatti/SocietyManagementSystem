@model SMS.Application.TenantSubscriptionDto

@{
    ViewData["Title"] = "Edit Tenant Subscription";
}

<div class="container mt-4">
    <h2>Edit Tenant Subscription</h2>
    <hr />

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()

        <input asp-for="SubscriptionId" type="hidden" />
        <input asp-for="CreatedOn" type="hidden" />
        <input asp-for="CreatedBy" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="TenantId" class="form-label">Tenant</label>
                <select asp-for="TenantId"
                        asp-items="ViewBag.Tenants"
                        class="form-select">
                    <option value="">-- Select Tenant --</option>
                </select>
                <span asp-validation-for="TenantId" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="PlanId" class="form-label">Plan</label>
                <select asp-for="PlanId"
                        asp-items="ViewBag.Plans"
                        class="form-select">
                    <option value="">-- Select Plan --</option>
                </select>
                <span asp-validation-for="PlanId" class="text-danger"></span>
                <small class="text-muted">The Plans dropdown must be connected to your Plans service.</small>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="StartDate" class="form-label">Start Date</label>
                <input asp-for="StartDate" type="date" class="form-control" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="EndDate" class="form-label">End Date</label>
                <input asp-for="EndDate" type="date" class="form-control" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Status" class="form-label">Status</label>
                <select asp-for="Status" class="form-select">
                    <option value="Active">Active</option>
                    <option value="Pending">Pending</option>
                    <option value="Expired">Expired</option>
                    <option value="Cancelled">Cancelled</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="AmountPaid" class="form-label">Amount Paid</label>
                <input asp-for="AmountPaid"
                       type="number"
                       min="0"
                       step="0.01"
                       class="form-control" />
                <span asp-validation-for="AmountPaid" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="PaymentReference" class="form-label">Payment Reference</label>
                <input asp-for="PaymentReference" class="form-control" maxlength="100" />
                <span asp-validation-for="PaymentReference" class="text-danger"></span>
            </div>

            <div class="col-md-12 mb-3">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description"
                          class="form-control"
                          rows="3"
                          maxlength="500"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Update Subscription</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
