@model SMS.Application.LanguageDto

@{
    ViewData["Title"] = "Language Details";
}

<h2>Language Details</h2>

<div>
    <dl class="row">
        <dt class="col-sm-3">Language Id</dt>
        <dd class="col-sm-9">@Model.LanguageId</dd>

        <dt class="col-sm-3">Language Code</dt>
        <dd class="col-sm-9">@Model.LanguageCode</dd>

        <dt class="col-sm-3">Language Name</dt>
        <dd class="col-sm-9">@Model.LanguageName</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Description</dd>

        <dt class="col-sm-3">Active</dt>
        <dd class="col-sm-9">@Model.IsActive</dd>

        <dt class="col-sm-3">Created On</dt>
        <dd class="col-sm-9">@Model.CreatedOn</dd>

        <dt class="col-sm-3">Created By</dt>
        <dd class="col-sm-9">@Model.CreatedBy</dd>

        <dt class="col-sm-3">Modified On</dt>
        <dd class="col-sm-9">@Model.ModifyOn</dd>

        <dt class="col-sm-3">Modified By</dt>
        <dd class="col-sm-9">@Model.ModifyBy</dd>
    </dl>
</div>

<a asp-action="Edit" asp-route-id="@Model.LanguageId" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>