@model IEnumerable<SMS.Application.LanguageDto>

@{
    ViewData["Title"] = "Languages";
}

<h2>Languages</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Create Language</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Code</th>
            <th>Name</th>
            <th>Description</th>
            <th>Active</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.LanguageId</td>
                <td>@item.LanguageCode</td>
                <td>@item.LanguageName</td>
                <td>@item.Description</td>
                <td>@item.IsActive</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.LanguageId" class="btn btn-info btn-sm">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.LanguageId" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.LanguageId" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>