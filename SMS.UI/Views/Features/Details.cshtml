@model SMS.Application.FeatureDto

@{
    ViewData["Title"] = "Feature Details";
}

<h2>Feature Details</h2>

<dl class="row">
    <dt class="col-sm-3">Feature ID</dt>
    <dd class="col-sm-9">@Model.FeatureId</dd>

    <dt class="col-sm-3">Feature Name</dt>
    <dd class="col-sm-9">@Model.FeatureName</dd>

    <dt class="col-sm-3">Feature Code</dt>
    <dd class="col-sm-9">@Model.FeatureCode</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Description</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@(Model.IsActive ? "Active" : "Inactive")</dd>

    <dt class="col-sm-3">Created On</dt>
    <dd class="col-sm-9">@Model.CreatedOn</dd>

    <dt class="col-sm-3">Modified On</dt>
    <dd class="col-sm-9">@Model.ModifyOn</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.FeatureId"
   class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>
