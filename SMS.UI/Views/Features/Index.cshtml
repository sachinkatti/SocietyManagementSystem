@model IEnumerable<SMS.Application.FeatureDto>

@{
    ViewData["Title"] = "Features";
}

<h2>Features</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Add Feature</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Feature Name</th>
            <th>Feature Code</th>
            <th>Description</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FeatureId</td>
                <td>@item.FeatureName</td>
                <td>@item.FeatureCode</td>
                <td>@item.Description</td>
                <td>@(item.IsActive ? "Active" : "Inactive")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.FeatureId"
                       class="btn btn-info btn-sm">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.FeatureId"
                       class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.FeatureId"
                       class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>