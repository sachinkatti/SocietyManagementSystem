@model SMS.Application.FeatureDto

@{
    ViewData["Title"] = "Delete Feature";
}

<h2>Delete Feature</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this feature?
</div>

<dl class="row">
    <dt class="col-sm-3">Feature ID</dt>
    <dd class="col-sm-9">@Model.FeatureId</dd>

    <dt class="col-sm-3">Feature Name</dt>
    <dd class="col-sm-9">@Model.FeatureName</dd>

    <dt class="col-sm-3">Feature Code</dt>
    <dd class="col-sm-9">@Model.FeatureCode</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Description</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.FeatureId" method="post">
    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
