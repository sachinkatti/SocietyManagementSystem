@model SMS.Application.AmenityDto

<h2>Edit Amenity</h2>

<form asp-action="Edit" asp-route-id="@Model.AmenityId" method="post">
    @Html.AntiForgeryToken()

    <input asp-for="AmenityId" type="hidden" />
    <input asp-for="TenantId" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" maxlength="100" required />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DepositRequired" class="form-label">Deposit Required</label>
        <input asp-for="DepositRequired" type="number" step="0.01" min="0" class="form-control" required />
        <span asp-validation-for="DepositRequired" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MaxSlotHours" class="form-label">Maximum Slot Hours</label>
        <input asp-for="MaxSlotHours" type="number" min="1" class="form-control" required />
        <span asp-validation-for="MaxSlotHours" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" maxlength="500"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Update</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>
