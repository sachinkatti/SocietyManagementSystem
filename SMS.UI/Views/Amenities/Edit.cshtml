@model SMS.Application.AmenityDto

@{
    ViewData["Title"] = "Edit Amenity";
}

<div class="container py-4">
    <div class="mb-4">
        <h2 class="fw-bold">Edit Amenity</h2>
        <p class="text-muted">Update facility information.</p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form asp-action="Edit" asp-route-id="@Model.AmenityId"
                  method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="AmenityId" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label class="form-label">Amenity ID</label>
                    <input value="@Model.AmenityId"
                           class="form-control" readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="TenantId" class="form-label">
                        Society / Tenant
                    </label>
                    <select asp-for="TenantId"
                            asp-items="ViewBag.Tenants"
                            class="form-select">
                        <option value="">-- Select Tenant --</option>
                    </select>
                    <span asp-validation-for="TenantId"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">
                        Amenity Name
                    </label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name"
                          class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="DepositRequired"
                               class="form-label">
                            Deposit Required
                        </label>
                        <input asp-for="DepositRequired"
                               type="number" min="0" step="0.01"
                               class="form-control" />
                        <span asp-validation-for="DepositRequired"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="MaxSlotHours"
                               class="form-label">
                            Maximum Slot Hours
                        </label>
                        <input asp-for="MaxSlotHours"
                               type="number" min="1"
                               class="form-control" />
                        <span asp-validation-for="MaxSlotHours"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label">
                        Description
                    </label>
                    <textarea asp-for="Description"
                              class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Update Amenity
                    </button>
                    <a asp-action="Index"
                       class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
