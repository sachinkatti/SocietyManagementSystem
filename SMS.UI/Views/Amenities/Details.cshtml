@model SMS.Application.AmenityDto

@{
    ViewData["Title"] = "Amenity Details";
}

<div class="container py-4">
    <div class="mb-4">
        <h2 class="fw-bold">Amenity Details</h2>
        <p class="text-muted">View complete facility information.</p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-md-3 mb-3">Amenity ID</dt>
                <dd class="col-md-9 mb-3">@Model.AmenityId</dd>

                <dt class="col-md-3 mb-3">Tenant</dt>
                <dd class="col-md-9 mb-3">@Model.TenantName</dd>

                <dt class="col-md-3 mb-3">Name</dt>
                <dd class="col-md-9 mb-3">@Model.Name</dd>

                <dt class="col-md-3 mb-3">Deposit Required</dt>
                <dd class="col-md-9 mb-3">
                    @Model.DepositRequired.ToString("N2")
                </dd>

                <dt class="col-md-3 mb-3">Maximum Slot Hours</dt>
                <dd class="col-md-9 mb-3">@Model.MaxSlotHours</dd>

                <dt class="col-md-3 mb-3">Description</dt>
                <dd class="col-md-9 mb-3">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "-"
                        : Model.Description)
                </dd>

                <dt class="col-md-3 mb-3">Created On</dt>
                <dd class="col-md-9 mb-3">
                    @Model.CreatedOn.ToString("dd MMM yyyy, hh:mm tt")
                </dd>
            </dl>

            <div class="d-flex gap-2 mt-3">
                <a asp-action="Edit"
                   asp-route-id="@Model.AmenityId"
                   class="btn btn-primary">Edit</a>
                <a asp-action="Index"
                   class="btn btn-outline-secondary">Back to List</a>
            </div>
        </div>
    </div>
</div>
