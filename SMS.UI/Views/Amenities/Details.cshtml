@model SMS.Application.AmenityDto

<h2>Amenity Details</h2>

<dl class="row">
    <dt class="col-sm-3">Amenity ID</dt>
    <dd class="col-sm-9">@Model.AmenityId</dd>

    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Deposit Required</dt>
    <dd class="col-sm-9">@Model.DepositRequired.ToString("0.00")</dd>

    <dt class="col-sm-3">Maximum Slot Hours</dt>
    <dd class="col-sm-9">@Model.MaxSlotHours</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Description</dd>

    <dt class="col-sm-3">Tenant ID</dt>
    <dd class="col-sm-9">@Model.TenantId</dd>

    <dt class="col-sm-3">Active</dt>
    <dd class="col-sm-9">@(Model.IsActive ? "Yes" : "No")</dd>

    <dt class="col-sm-3">Created On</dt>
    <dd class="col-sm-9">@Model.CreatedOn</dd>

    <dt class="col-sm-3">Created By</dt>
    <dd class="col-sm-9">@Model.CreatedBy</dd>

    <dt class="col-sm-3">Modified On</dt>
    <dd class="col-sm-9">@Model.ModifyOn</dd>

    <dt class="col-sm-3">Modified By</dt>
    <dd class="col-sm-9">@Model.ModifyBy</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.AmenityId" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>
