@model SMS.Application.AmenityDto

@{
    ViewData["Title"] = "Delete Amenity";
}

<div class="container py-4">
    <div class="mb-4">
        <h2 class="fw-bold">Deactivate Amenity</h2>
        <p class="text-muted">Confirm before deactivating this facility.</p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <div class="alert alert-warning">
                This action will deactivate the amenity, not permanently
                delete the database record.
            </div>

            <h5 class="fw-bold">@Model.Name</h5>

            <dl class="row mt-3">
                <dt class="col-sm-4">Amenity ID</dt>
                <dd class="col-sm-8">@Model.AmenityId</dd>

                <dt class="col-sm-4">Tenant</dt>
                <dd class="col-sm-8">@Model.TenantName</dd>

                <dt class="col-sm-4">Deposit Required</dt>
                <dd class="col-sm-8">
                    @Model.DepositRequired.ToString("N2")
                </dd>

                <dt class="col-sm-4">Maximum Slot Hours</dt>
                <dd class="col-sm-8">@Model.MaxSlotHours</dd>
            </dl>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.AmenityId" />

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-danger">
                        Confirm Deactivation
                    </button>
                    <a asp-action="Index"
                       class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
