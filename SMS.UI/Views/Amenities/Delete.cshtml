@model SMS.Application.AmenityDto

<h2>Delete Amenity</h2>

<p>Are you sure you want to deactivate this amenity?</p>

<dl class="row">
    <dt class="col-sm-3">Amenity ID</dt>
    <dd class="col-sm-9">@Model.AmenityId</dd>

    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Deposit Required</dt>
    <dd class="col-sm-9">@Model.DepositRequired.ToString("0.00")</dd>

    <dt class="col-sm-3">Maximum Slot Hours</dt>
    <dd class="col-sm-9">@Model.MaxSlotHours</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.AmenityId" method="post">
    @Html.AntiForgeryToken()

    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
