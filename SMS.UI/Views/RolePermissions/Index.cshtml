@model IEnumerable<SMS.Application.RolePermissionDto>

@{
    ViewData["Title"] = "Role-Permission Mapping";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Role-Permission Mapping</h2>
        <a asp-action="Create" class="btn btn-primary">Assign Permission</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Mapping ID</th>
                    <th>Role</th>
                    <th>Permission</th>
                    <th>Permission Code</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var mapping in Model)
                    {
                        <tr>
                            <td>@mapping.RolePermissionId</td>
                            <td>@mapping.RoleName</td>
                            <td>@mapping.PermissionName</td>
                            <td>@mapping.PermissionCode</td>
                            <td>@mapping.Description</td>
                            <td>@(mapping.IsActive ? "Active" : "Inactive")</td>
                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@mapping.RolePermissionId"
                                   class="btn btn-info btn-sm">Details</a>

                                <a asp-action="Delete"
                                   asp-route-id="@mapping.RolePermissionId"
                                   class="btn btn-danger btn-sm">Remove</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center">
                            No role-permission assignments found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
