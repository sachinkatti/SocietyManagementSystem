@model SMS.Application.ComplaintDto

@{
    ViewData["Title"] = "Complaint Details";
}

<h2>Complaint Details</h2>

<hr />

<dl class="row">
    <dt class="col-sm-3">Complaint ID</dt>
    <dd class="col-sm-9">@Model.ComplaintId</dd>

    <dt class="col-sm-3">Tenant</dt>
    <dd class="col-sm-9">@(Model.TenantName ?? Model.TenantId.ToString())</dd>

    <dt class="col-sm-3">Resident</dt>
    <dd class="col-sm-9">@(Model.ResidentName ?? Model.ResidentId.ToString())</dd>

    <dt class="col-sm-3">Category</dt>
    <dd class="col-sm-9">@Model.Category</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Description</dd>

    <dt class="col-sm-3">Photo URL</dt>
    <dd class="col-sm-9">
        @if (!string.IsNullOrWhiteSpace(Model.PhotoUrl))
        {
            <a href="@Model.PhotoUrl" target="_blank" rel="noopener noreferrer">
                View Photo
            </a>
        }
        else
        {
            <span>Not provided</span>
        }
    </dd>

    <dt class="col-sm-3">Priority</dt>
    <dd class="col-sm-9">@Model.Priority</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>

    <dt class="col-sm-3">Date Raised</dt>
    <dd class="col-sm-9">@Model.DateRaised.ToString("dd-MM-yyyy hh:mm tt")</dd>

    <dt class="col-sm-3">Date Resolved</dt>
    <dd class="col-sm-9">
        @(Model.DateResolved?.ToString("dd-MM-yyyy hh:mm tt") ?? "Not resolved")
    </dd>

    <dt class="col-sm-3">Resolution Notes</dt>
    <dd class="col-sm-9">@(Model.ResolutionNotes ?? "None")</dd>

    <dt class="col-sm-3">Resident Rating</dt>
    <dd class="col-sm-9">@(Model.ResidentRating?.ToString() ?? "Not rated")</dd>

    <dt class="col-sm-3">Created On</dt>
    <dd class="col-sm-9">@Model.CreatedOn.ToString("dd-MM-yyyy hh:mm tt")</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.ComplaintId"
   class="btn btn-warning">Edit</a>

<a asp-action="Index" class="btn btn-secondary">Back to List</a>
