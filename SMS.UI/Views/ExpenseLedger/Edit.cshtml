@model SMS.Application.ExpenseLedgerDto

@{
    ViewData["Title"] = "Edit Expense Ledger Entry";
}

<div class="container mt-4">
    <h2>Edit Expense Ledger Entry</h2>
    <hr />

    <form asp-action="Edit" asp-route-id="@Model.LedgerId" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <input asp-for="LedgerId" type="hidden" />
        <input asp-for="TenantId" type="hidden" />
        <input asp-for="IsActive" type="hidden" />

        <div class="mb-3">
            <label asp-for="EntryType" class="form-label">Entry Type</label>
            <select asp-for="EntryType" class="form-select">
                <option value="Expense">Expense</option>
                <option value="Income">Income</option>
            </select>
            <span asp-validation-for="EntryType" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Category" class="form-label"></label>
            <input asp-for="Category" class="form-control" />
            <span asp-validation-for="Category" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Amount" class="form-label"></label>
            <input asp-for="Amount" type="number" min="0.01"
                   step="0.01" class="form-control" />
            <span asp-validation-for="Amount" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="EntryDate" class="form-label"></label>
            <input asp-for="EntryDate" type="date" class="form-control" />
            <span asp-validation-for="EntryDate" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="RecordedByAdminId" class="form-label">
                Recorded By Administrator
            </label>
            <select asp-for="RecordedByAdminId"
                    asp-items="ViewBag.Admins"
                    class="form-select">
                <option value="">-- Select Administrator --</option>
            </select>
            <span asp-validation-for="RecordedByAdminId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control"
                      rows="3" maxlength="500"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Update Entry</button>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
