@model IEnumerable<SMS.Application.ExpenseLedgerDto>

@{
    ViewData["Title"] = "Expense Ledger";
}

<h2>Expense Ledger</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Add New Entry</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Ledger ID</th>
            <th>Entry Type</th>
            <th>Category</th>
            <th>Amount</th>
            <th>Entry Date</th>
            <th>Admin ID</th>
            <th>Tenant ID</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.LedgerId</td>
                <td>@item.EntryType</td>
                <td>@item.Category</td>
                <td>@item.Amount.ToString("N2")</td>
                <td>@item.EntryDate.ToString("dd-MM-yyyy")</td>
                <td>@item.RecordedByAdminId</td>
                <td>@item.TenantId</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.LedgerId">Details</a> |
                    <a asp-action="Edit" asp-route-id="@item.LedgerId">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.LedgerId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>