@model SMS.Application.ExpenseLedgerDto

@{
    ViewData["Title"] = "Expense Entry Details";
}

<h2>Expense Entry Details</h2>

<dl class="row">
    <dt class="col-sm-3">Ledger ID</dt>
    <dd class="col-sm-9">@Model.LedgerId</dd>

    <dt class="col-sm-3">Entry Type</dt>
    <dd class="col-sm-9">@Model.EntryType</dd>

    <dt class="col-sm-3">Category</dt>
    <dd class="col-sm-9">@Model.Category</dd>

    <dt class="col-sm-3">Amount</dt>
    <dd class="col-sm-9">@Model.Amount.ToString("N2")</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@(Model.Description ?? "N/A")</dd>

    <dt class="col-sm-3">Entry Date</dt>
    <dd class="col-sm-9">@Model.EntryDate.ToString("dd-MM-yyyy")</dd>

    <dt class="col-sm-3">Recorded By Admin ID</dt>
    <dd class="col-sm-9">@Model.RecordedByAdminId</dd>

    <dt class="col-sm-3">Tenant ID</dt>
    <dd class="col-sm-9">@Model.TenantId</dd>

    <dt class="col-sm-3">Created On</dt>
    <dd class="col-sm-9">@Model.CreatedOn</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.LedgerId" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>