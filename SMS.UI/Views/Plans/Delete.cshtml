@model SMS.Application.PlanDto

@{
    ViewData["Title"] = "Delete Plan";
}

<h2>Delete Plan</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this plan?
</div>

<dl class="row">
    <dt class="col-sm-3">Plan ID</dt>
    <dd class="col-sm-9">@Model.PlanId</dd>

    <dt class="col-sm-3">Plan Name</dt>
    <dd class="col-sm-9">@Model.PlanName</dd>

    <dt class="col-sm-3">Plan Code</dt>
    <dd class="col-sm-9">@Model.PlanCode</dd>

    <dt class="col-sm-3">Billing Cycle</dt>
    <dd class="col-sm-9">@Model.BillingCycle</dd>

    <dt class="col-sm-3">Price</dt>
    <dd class="col-sm-9">@Model.Price.ToString("N2")</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.PlanId" method="post">
    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
