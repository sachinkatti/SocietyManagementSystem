@model SMS.Application.PlanDto

@{
    ViewData["Title"] = "Plan Details";
}

<h2>Plan Details</h2>

<dl class="row">
    <dt class="col-sm-3">Plan ID</dt>
    <dd class="col-sm-9">@Model.PlanId</dd>

    <dt class="col-sm-3">Plan Name</dt>
    <dd class="col-sm-9">@Model.PlanName</dd>

    <dt class="col-sm-3">Plan Code</dt>
    <dd class="col-sm-9">@Model.PlanCode</dd>

    <dt class="col-sm-3">Billing Cycle</dt>
    <dd class="col-sm-9">@Model.BillingCycle</dd>

    <dt class="col-sm-3">Price</dt>
    <dd class="col-sm-9">@Model.Price.ToString("N2")</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Description</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@(Model.IsActive ? "Active" : "Inactive")</dd>

    <dt class="col-sm-3">Created On</dt>
    <dd class="col-sm-9">@Model.CreatedOn</dd>

    <dt class="col-sm-3">Modified On</dt>
    <dd class="col-sm-9">@Model.ModifyOn</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.PlanId"
   class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>
