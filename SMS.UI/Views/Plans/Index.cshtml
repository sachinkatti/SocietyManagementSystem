@model IEnumerable<SMS.Application.PlanDto>

@{
    ViewData["Title"] = "Plans";
}

<h2>Plans</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Add Plan</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Plan Name</th>
            <th>Plan Code</th>
            <th>Billing Cycle</th>
            <th>Price</th>
            <th>Description</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.PlanId</td>
                <td>@item.PlanName</td>
                <td>@item.PlanCode</td>
                <td>@item.BillingCycle</td>
                <td>@item.Price.ToString("N2")</td>
                <td>@item.Description</td>
                <td>@(item.IsActive ? "Active" : "Inactive")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.PlanId"
                       class="btn btn-info btn-sm">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.PlanId"
                       class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.PlanId"
                       class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
