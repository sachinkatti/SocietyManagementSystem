@model SMS.Application.ResidentDto

@{
    ViewData["Title"] = "Add Resident";
}

<h2>Add Resident</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="UserId" class="form-label">User</label>
        <select asp-for="UserId"
                asp-items="ViewBag.Users"
                class="form-select">
            <option value="">-- Select User --</option>
        </select>
        <span asp-validation-for="UserId"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FlatId" class="form-label">Flat</label>
        <select asp-for="FlatId"
                asp-items="ViewBag.Flats"
                class="form-select">
            <option value="">-- Select Flat --</option>
        </select>
        <span asp-validation-for="FlatId"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ResidentType" class="form-label"></label>
        <select asp-for="ResidentType" class="form-select">
            <option value="">-- Select Resident Type --</option>
            <option value="Owner">Owner</option>
            <option value="Tenant">Tenant</option>
            <option value="Family Member">Family Member</option>
        </select>
        <span asp-validation-for="ResidentType"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MoveInDate" class="form-label"></label>
        <input asp-for="MoveInDate"
               type="date"
               class="form-control" />
        <span asp-validation-for="MoveInDate"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EmergencyContact" class="form-label"></label>
        <input asp-for="EmergencyContact"
               class="form-control"
               maxlength="15"
               placeholder="Enter emergency contact" />
        <span asp-validation-for="EmergencyContact"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}