@model SMS.Application.ResidentDto

@{
    ViewData["Title"] = "Resident Details";
}

<h2>Resident Details</h2>

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.FullName</dd>

    <dt class="col-sm-3">Flat</dt>
    <dd class="col-sm-9">@Model.FlatNumber</dd>

    <dt class="col-sm-3">Wing</dt>
    <dd class="col-sm-9">@Model.WingName</dd>

    <dt class="col-sm-3">Resident Type</dt>
    <dd class="col-sm-9">@Model.ResidentType</dd>

    <dt class="col-sm-3">Move-in Date</dt>
    <dd class="col-sm-9">@Model.MoveInDate.ToString("dd-MMM-yyyy")</dd>

    <dt class="col-sm-3">Emergency Contact</dt>
    <dd class="col-sm-9">@(Model.EmergencyContact ?? "Not provided")</dd>
</dl>

<a asp-action="Edit"
   asp-route-id="@Model.ResidentId"
   class="btn btn-warning">Edit</a>

<a asp-action="Index" class="btn btn-secondary">Back</a>
