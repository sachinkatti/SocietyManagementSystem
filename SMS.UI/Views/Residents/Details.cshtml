@model SMS.Application.ResidentDto

@{
    ViewData["Title"] = "Resident Details";
}

<h2>Resident Details</h2>

<dl class="row">
    <dt class="col-sm-3">Resident ID</dt>
    <dd class="col-sm-9">@Model.ResidentId</dd>

    <dt class="col-sm-3">User ID</dt>
    <dd class="col-sm-9">@Model.UserId</dd>

    <dt class="col-sm-3">Flat ID</dt>
    <dd class="col-sm-9">@Model.FlatId</dd>

    <dt class="col-sm-3">Resident Type</dt>
    <dd class="col-sm-9">@Model.ResidentType</dd>

    <dt class="col-sm-3">Move In Date</dt>
    <dd class="col-sm-9">@Model.MoveInDate.ToString("yyyy-MM-dd")</dd>

    <dt class="col-sm-3">Emergency Contact</dt>
    <dd class="col-sm-9">@Model.EmergencyContact</dd>

    <dt class="col-sm-3">Created On</dt>
    <dd class="col-sm-9">@Model.CreatedOn</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.ResidentId" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>
