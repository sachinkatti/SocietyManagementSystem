@model SMS.Application.PaymentDto

@{
    ViewData["Title"] = "Delete Payment";
}

<div class="container mt-4">
    <h2>Delete Payment</h2>
    <hr />

    <div class="alert alert-warning">
        Are you sure you want to delete this payment?
        This action cannot be undone.
    </div>

    <dl class="row">
        <dt class="col-sm-3">Payment ID</dt>
        <dd class="col-sm-9">@Model.PaymentId</dd>

        <dt class="col-sm-3">Invoice Number</dt>
        <dd class="col-sm-9">@Model.InvoiceNumber</dd>

        <dt class="col-sm-3">Payment Reference</dt>
        <dd class="col-sm-9">@Model.PaymentReference</dd>

        <dt class="col-sm-3">Payment Date</dt>
        <dd class="col-sm-9">
            @Model.PaymentDate.ToString("dd-MM-yyyy HH:mm")
        </dd>

        <dt class="col-sm-3">Amount</dt>
        <dd class="col-sm-9">@Model.Amount.ToString("N2")</dd>

        <dt class="col-sm-3">Payment Method</dt>
        <dd class="col-sm-9">@Model.PaymentMethod</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" name="id" value="@Model.PaymentId" />

        <button type="submit" class="btn btn-danger">
            Confirm Delete
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>
