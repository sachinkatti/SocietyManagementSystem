@model SMS.Application.MaintenanceBillDto

@{
    ViewData["Title"] = "Maintenance Bill Details";
}

<div class="container mt-4">
    <h2>Maintenance Bill Details</h2>
    <hr />

    <div class="card">
        <div class="card-header">
            <strong>Bill #@Model.BillId</strong>
        </div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">Tenant</dt>
                <dd class="col-sm-8">@Model.TenantName</dd>

                <dt class="col-sm-4">Flat Number</dt>
                <dd class="col-sm-8">@Model.FlatNumber</dd>

                <dt class="col-sm-4">Billing Month</dt>
                <dd class="col-sm-8">
                    @(new DateTime(Model.BillingYear, Model.BillingMonth, 1)
                        .ToString("MMMM yyyy"))
                </dd>

                <dt class="col-sm-4">Base Amount</dt>
                <dd class="col-sm-8">₹@Model.BaseAmount.ToString("N2")</dd>

                <dt class="col-sm-4">Penalty Amount</dt>
                <dd class="col-sm-8">₹@Model.PenaltyAmount.ToString("N2")</dd>

                <dt class="col-sm-4">Total Amount</dt>
                <dd class="col-sm-8">
                    <strong>₹@Model.TotalAmount.ToString("N2")</strong>
                </dd>

                <dt class="col-sm-4">Due Date</dt>
                <dd class="col-sm-8">@Model.DueDate.ToString("dd-MMM-yyyy")</dd>

                <dt class="col-sm-4">Payment Status</dt>
                <dd class="col-sm-8">@Model.PaymentStatus</dd>

                <dt class="col-sm-4">Payment Date</dt>
                <dd class="col-sm-8">
                    @(Model.PaymentDate?.ToString("dd-MMM-yyyy") ?? "Not paid")
                </dd>

                <dt class="col-sm-4">Transaction Reference</dt>
                <dd class="col-sm-8">
                    @(string.IsNullOrWhiteSpace(Model.TransactionRef)
                        ? "Not available"
                        : Model.TransactionRef)
                </dd>

                <dt class="col-sm-4">Description</dt>
                <dd class="col-sm-8">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "No description"
                        : Model.Description)
                </dd>
            </dl>
        </div>

        <div class="card-footer">
            <a asp-action="Edit"
               asp-route-id="@Model.BillId"
               class="btn btn-warning">Edit</a>

            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>
