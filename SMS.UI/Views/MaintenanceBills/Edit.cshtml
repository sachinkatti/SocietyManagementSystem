@model SMS.Application.MaintenanceBillDto

@{
    ViewData["Title"] = "Edit Maintenance Bill";
}

<div class="container mt-4">
    <h2>Edit Maintenance Bill #@Model.BillId</h2>
    <hr />

    <form asp-action="Edit" asp-route-id="@Model.BillId" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <input type="hidden" asp-for="BillId" />
        <input type="hidden" asp-for="TenantId" />

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="FlatId" class="form-label">Flat</label>
                <select asp-for="FlatId" asp-items="ViewBag.Flats"
                        class="form-select">
                    <option value="">-- Select Flat --</option>
                </select>
                <span asp-validation-for="FlatId" class="text-danger"></span>
            </div>

            <div class="col-md-3 mb-3">
                <label asp-for="BillingMonth" class="form-label">Billing Month</label>
                <select asp-for="BillingMonth" class="form-select">
                    @for (int month = 1; month <= 12; month++)
                    {
                        <option value="@month">
                            @(new DateTime(2000, month, 1).ToString("MMMM"))
                        </option>
                    }
                </select>
                <span asp-validation-for="BillingMonth" class="text-danger"></span>
            </div>

            <div class="col-md-3 mb-3">
                <label asp-for="BillingYear" class="form-label">Billing Year</label>
                <input asp-for="BillingYear" type="number" class="form-control" />
                <span asp-validation-for="BillingYear" class="text-danger"></span>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="BaseAmount" class="form-label">Base Amount (₹)</label>
                <input asp-for="BaseAmount" type="number" step="0.01"
                       min="0" class="form-control" />
                <span asp-validation-for="BaseAmount" class="text-danger"></span>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="PenaltyAmount" class="form-label">Penalty Amount (₹)</label>
                <input asp-for="PenaltyAmount" type="number" step="0.01"
                       min="0" class="form-control" />
                <span asp-validation-for="PenaltyAmount" class="text-danger"></span>
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">Total Amount (₹)</label>
                <input id="totalAmount" type="text" class="form-control"
                       value="@Model.TotalAmount.ToString("0.00")" readonly />
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="DueDate" class="form-label">Due Date</label>
                <input asp-for="DueDate" type="date" class="form-control" />
                <span asp-validation-for="DueDate" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="PaymentStatus" class="form-label">Payment Status</label>
                <select asp-for="PaymentStatus" class="form-select">
                    <option value="Pending">Pending</option>
                    <option value="Paid">Paid</option>
                    <option value="Overdue">Overdue</option>
                    <option value="Partially Paid">Partially Paid</option>
                </select>
                <span asp-validation-for="PaymentStatus" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="PaymentDate" class="form-label">Payment Date</label>
                <input asp-for="PaymentDate" type="date" class="form-control" />
                <span asp-validation-for="PaymentDate" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="TransactionRef" class="form-label">Transaction Reference</label>
                <input asp-for="TransactionRef" class="form-control" />
                <span asp-validation-for="TransactionRef" class="text-danger"></span>
            </div>

            <div class="col-12 mb-3">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Update Bill</button>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const baseAmount = document.getElementById("BaseAmount");
        const penaltyAmount = document.getElementById("PenaltyAmount");
        const totalAmount = document.getElementById("totalAmount");

        function calculateTotal() {
            const base = parseFloat(baseAmount.value) || 0;
            const penalty = parseFloat(penaltyAmount.value) || 0;
            totalAmount.value = (base + penalty).toFixed(2);
        }

        baseAmount.addEventListener("input", calculateTotal);
        penaltyAmount.addEventListener("input", calculateTotal);
        calculateTotal();
    </script>
}
