@model SMS.Application.VehicleRegistryDto

@{
    ViewData["Title"] = "Edit Vehicle";
}

<div class="container py-4" style="max-width:850px;">
    <div class="mb-4">
        <h2 class="fw-bold">Edit Vehicle</h2>
        <p class="text-muted">Update vehicle registration details.</p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="VehicleId" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="TenantId" class="form-label">Tenant / Society</label>
                    <select asp-for="TenantId"
                            asp-items="ViewBag.Tenants"
                            class="form-select"
                            id="TenantId">
                        <option value="">-- Select Tenant --</option>
                    </select>
                    <span asp-validation-for="TenantId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FlatId" class="form-label">Wing and Flat</label>
                    <select asp-for="FlatId"
                            asp-items="ViewBag.Flats"
                            class="form-select"
                            id="FlatId">
                        <option value="">-- Select Flat --</option>
                    </select>
                    <span asp-validation-for="FlatId" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="VehicleNumber" class="form-label"></label>
                        <input asp-for="VehicleNumber" class="form-control"
                               style="text-transform:uppercase" />
                        <span asp-validation-for="VehicleNumber"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="VehicleType" class="form-label"></label>
                        <select asp-for="VehicleType" class="form-select">
                            <option value="">-- Select Type --</option>
                            <option value="Two Wheeler">Two Wheeler</option>
                            <option value="Four Wheeler">Four Wheeler</option>
                            <option value="Bicycle">Bicycle</option>
                            <option value="Commercial">Commercial</option>
                            <option value="Other">Other</option>
                        </select>
                        <span asp-validation-for="VehicleType"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description"
                              class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Update Vehicle</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const tenant = document.getElementById("TenantId");
            const flat = document.getElementById("FlatId");
            const initialFlatId = flat.value;

            async function loadFlats(tenantId, selectedFlatId) {
                flat.innerHTML = "";
                flat.add(new Option("-- Select Flat --", ""));
                flat.disabled = true;

                if (!tenantId) return;

                try {
                    const response = await fetch(
                        '@Url.Action("GetFlatsByTenant", "VehicleRegistry")'
                        + '?tenantId=' + encodeURIComponent(tenantId));

                    if (!response.ok) throw new Error("Unable to load flats.");

                    const flats = await response.json();
                    flat.innerHTML = "";
                    flat.add(new Option("-- Select Flat --", ""));

                    flats.forEach(function (item) {
                        const option = new Option(item.text, item.id);
                        if (String(item.id) === String(selectedFlatId)) {
                            option.selected = true;
                        }
                        flat.add(option);
                    });

                    flat.disabled = false;
                } catch (error) {
                    flat.innerHTML = "";
                    flat.add(new Option("-- Failed to Load Flats --", ""));
                }
            }

            tenant.addEventListener("change", function () {
                loadFlats(tenant.value, "");
            });

            loadFlats(tenant.value, initialFlatId);
        });
    </script>
}