@model IEnumerable<SMS.Application.VehicleRegistryDto>

@{
    ViewData["Title"] = "Vehicle Registry";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Vehicle Registry</h2>
            <p class="text-muted mb-0">Manage registered society vehicles.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            + Register Vehicle
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Vehicle No.</th>
                            <th>Type</th>
                            <th>Tenant</th>
                            <th>Wing</th>
                            <th>Flat</th>
                            <th>Description</th>
                            <th style="min-width:180px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var vehicle in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @vehicle.VehicleNumber
                                    </td>
                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @vehicle.VehicleType
                                        </span>
                                    </td>
                                    <td>@vehicle.TenantName</td>
                                    <td>@vehicle.WingName</td>
                                    <td>@vehicle.FlatNumber</td>
                                    <td>
                                        @(string.IsNullOrWhiteSpace(vehicle.Description)
                                            ? "-"
                                            : vehicle.Description)
                                    </td>
                                    <td>
                                        <a asp-action="Details"
                                           asp-route-id="@vehicle.VehicleId"
                                           class="btn btn-sm btn-outline-info">Details</a>

                                        <a asp-action="Edit"
                                           asp-route-id="@vehicle.VehicleId"
                                           class="btn btn-sm btn-outline-primary">Edit</a>

                                        <a asp-action="Delete"
                                           asp-route-id="@vehicle.VehicleId"
                                           class="btn btn-sm btn-outline-danger">Delete</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <h5>No vehicles registered</h5>
                                    <p class="text-muted">
                                        Register your first vehicle to get started.
                                    </p>
                                    <a asp-action="Create" class="btn btn-primary">
                                        Register Vehicle
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>