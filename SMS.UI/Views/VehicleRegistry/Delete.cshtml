@model SMS.Application.VehicleRegistryDto

<h2>Vehicle Details</h2>

<dl class="row">
    <dt class="col-sm-3">Flat</dt>
    <dd class="col-sm-9">@Model.FlatNumber</dd>
    <dt class="col-sm-3">Vehicle Number</dt>
    <dd class="col-sm-9">@Model.VehicleNumber</dd>
    <dt class="col-sm-3">Vehicle Type</dt>
    <dd class="col-sm-9">@Model.VehicleType</dd>
    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Description</dd>
</dl>

<a asp-action="Index" class="btn btn-secondary">Back</a>
<a asp-action="Edit" asp-route-id="@Model.VehicleId" class="btn btn-primary">Edit</a>