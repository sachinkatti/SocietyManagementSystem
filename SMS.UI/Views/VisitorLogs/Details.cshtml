@model SMS.Application.VisitorLogDto

@{
    ViewData["Title"] = "Visitor Details";
}

<h2>Visitor Details</h2>

<dl class="row">
    <dt class="col-sm-3">Visitor ID</dt>
    <dd class="col-sm-9">@Model.VisitorId</dd>

    <dt class="col-sm-3">Visitor Name</dt>
    <dd class="col-sm-9">@Model.VisitorName</dd>

    <dt class="col-sm-3">Phone Number</dt>
    <dd class="col-sm-9">@Model.PhoneNumber</dd>

    <dt class="col-sm-3">Visiting Flat</dt>
    <dd class="col-sm-9">@Model.FlatNumber (@Model.VisitingFlatId)</dd>

    <dt class="col-sm-3">Purpose</dt>
    <dd class="col-sm-9">@Model.Purpose</dd>

    <dt class="col-sm-3">Vehicle Number</dt>
    <dd class="col-sm-9">@Model.VehicleNumber</dd>

    <dt class="col-sm-3">Approval Method</dt>
    <dd class="col-sm-9">@Model.ApprovalMethod</dd>

    <dt class="col-sm-3">Entry Time</dt>
    <dd class="col-sm-9">@Model.EntryTime.ToString("dd-MM-yyyy HH:mm")</dd>

    <dt class="col-sm-3">Exit Time</dt>
    <dd class="col-sm-9">@(Model.ExitTime?.ToString("dd-MM-yyyy HH:mm") ?? "-")</dd>

    <dt class="col-sm-3">Logged By Guard</dt>
    <dd class="col-sm-9">@Model.GuardName</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Description</dd>

    <dt class="col-sm-3">Tenant ID</dt>
    <dd class="col-sm-9">@Model.TenantId</dd>

    <dt class="col-sm-3">Created On</dt>
    <dd class="col-sm-9">@Model.CreatedOn.ToString("dd-MM-yyyy HH:mm")</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.VisitorId" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>