@model SMS.Application.VisitorLogDto

@{
    ViewData["Title"] = "Add Visitor";
}

<h2>Add Visitor</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="TenantId" class="form-label">Tenant</label>
        <select asp-for="TenantId"
                asp-items="ViewBag.Tenants"
                class="form-select"
                id="TenantId">
            <option value="">-- Select Tenant --</option>
        </select>
        <span asp-validation-for="TenantId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="VisitorName" class="form-label"></label>
        <input asp-for="VisitorName" class="form-control" />
        <span asp-validation-for="VisitorName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PhoneNumber" class="form-label"></label>
        <input asp-for="PhoneNumber" class="form-control" />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="VisitingFlatId" class="form-label">Flat</label>
        <select asp-for="VisitingFlatId" class="form-select" id="VisitingFlatId">
            <option value="">-- Select Tenant First --</option>
        </select>
        <span asp-validation-for="VisitingFlatId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Purpose" class="form-label"></label>
        <select asp-for="Purpose" class="form-select">
            <option value="">-- Select Purpose --</option>
            <option value="Guest">Guest</option>
            <option value="Delivery">Delivery</option>
            <option value="Service">Service</option>
            <option value="Personal">Personal</option>
            <option value="Other">Other</option>
        </select>
        <span asp-validation-for="Purpose" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="VehicleNumber" class="form-label"></label>
        <input asp-for="VehicleNumber" class="form-control" />
        <span asp-validation-for="VehicleNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ApprovalMethod" class="form-label"></label>
        <select asp-for="ApprovalMethod" class="form-select">
            <option value="">-- Select Approval Method --</option>
            <option value="App">App</option>
            <option value="Manual">Manual</option>
            <option value="Pre-Approved">Pre-Approved</option>
            <option value="Resident">Resident</option>
        </select>
        <span asp-validation-for="ApprovalMethod" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EntryTime" class="form-label"></label>
        <input asp-for="EntryTime"
               type="datetime-local"
               class="form-control"
               value="@Model.EntryTime.ToString("yyyy-MM-ddTHH:mm")" />
        <span asp-validation-for="EntryTime" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ExitTime" class="form-label"></label>
        <input asp-for="ExitTime"
               type="datetime-local"
               class="form-control"
               value="@(Model.ExitTime?.ToString("yyyy-MM-ddTHH:mm"))" />
        <span asp-validation-for="ExitTime" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="LoggedByGuardId" class="form-label">Security Guard</label>
        <select asp-for="LoggedByGuardId"
                class="form-select"
                id="LoggedByGuardId">
            <option value="">-- Select Tenant First --</option>
        </select>
        <span asp-validation-for="LoggedByGuardId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            $("#TenantId").change(function () {
                var tenantId = $(this).val();

                $("#VisitingFlatId").empty()
                    .append('<option value="">-- Select Flat --</option>');

                $("#LoggedByGuardId").empty()
                    .append('<option value="">-- Select Guard --</option>');

                if (!tenantId) {
                    return;
                }

                $.getJSON('@Url.Action("GetFlatsByTenant", "VisitorLogs")',
                    { tenantId: tenantId },
                    function (data) {
                        $.each(data, function (index, item) {
                            $("#VisitingFlatId").append(
                                $('<option></option>')
                                    .val(item.id)
                                    .text(item.text));
                        });
                    });

                $.getJSON('@Url.Action("GetGuardsByTenant", "VisitorLogs")',
                    { tenantId: tenantId },
                    function (data) {
                        $.each(data, function (index, item) {
                            $("#LoggedByGuardId").append(
                                $('<option></option>')
                                    .val(item.id)
                                    .text(item.text));
                        });
                    });
            });
        });
    </script>
}
