@model List<SMS.Application.NoticeDto>

<h2>Notices</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Create Notice</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Category</th>
            <th>Publish Date</th>
            <th>Admin ID</th>
            <th>Tenant ID</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Category</td>
                <td>@item.PublishDate.ToString("dd-MM-yyyy")</td>
                <td>@item.PublishedByAdminId</td>
                <td>@item.TenantId</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.NoticeId">Details</a> |
                    <a asp-action="Edit" asp-route-id="@item.NoticeId">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.NoticeId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>