@model SMS.Application.NoticeDto

<h2>Delete Notice</h2>

<p>Are you sure you want to deactivate this notice?</p>

<dl class="row">
    <dt class="col-sm-3">Title</dt>
    <dd class="col-sm-9">@Model.Title</dd>

    <dt class="col-sm-3">Category</dt>
    <dd class="col-sm-9">@Model.Category</dd>

    <dt class="col-sm-3">Publish Date</dt>
    <dd class="col-sm-9">@Model.PublishDate.ToString("dd-MM-yyyy")</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.NoticeId" method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>