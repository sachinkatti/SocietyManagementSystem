@model SMS.Application.InvoiceDto

@{
    ViewData["Title"] = "Delete Invoice";
}

<h2>Delete Invoice</h2>

<h3>Are you sure you want to delete this invoice?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">Invoice Number</dt>
        <dd class="col-sm-10">@Model.InvoiceNumber</dd>

        <dt class="col-sm-2">Tenant ID</dt>
        <dd class="col-sm-10">@Model.TenantId</dd>

        <dt class="col-sm-2">Total Amount</dt>
        <dd class="col-sm-10">@Model.TotalAmount.ToString("C")</dd>
    </dl>

    <form asp-action="Delete">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="InvoiceId" />
        <button type="submit" class="btn btn-danger">Delete</button> |
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>