@model IEnumerable<SMS.Application.InvoiceDto>

@{
    ViewData["Title"] = "Invoices";
}

<h2>Invoices</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Invoice</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Invoice Number</th>
            <th>Tenant ID</th>
            <th>Invoice Date</th>
            <th>Due Date</th>
            <th>Total Amount</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.InvoiceNumber</td>
                <td>@item.TenantId</td>
                <td>@item.InvoiceDate.ToShortDateString()</td>
                <td>@item.DueDate.ToShortDateString()</td>
                <td>@item.TotalAmount.ToString("C")</td>
                <td>@item.Status</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.InvoiceId" class="btn btn-sm btn-warning">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.InvoiceId" class="btn btn-sm btn-info">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.InvoiceId" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>