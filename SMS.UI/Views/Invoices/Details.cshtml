@model SMS.Application.InvoiceDto

@{
    ViewData["Title"] = "Invoice Details";
}

<h2>Invoice Details</h2>

<div>
    <dl class="row">
        <dt class="col-sm-2">Invoice Number</dt>
        <dd class="col-sm-10">@Model.InvoiceNumber</dd>

        <dt class="col-sm-2">Tenant ID</dt>
        <dd class="col-sm-10">@Model.TenantId</dd>

        <dt class="col-sm-2">Subscription ID</dt>
        <dd class="col-sm-10">@Model.SubscriptionId</dd>

        <dt class="col-sm-2">Invoice Date</dt>
        <dd class="col-sm-10">@Model.InvoiceDate.ToShortDateString()</dd>

        <dt class="col-sm-2">Due Date</dt>
        <dd class="col-sm-10">@Model.DueDate.ToShortDateString()</dd>

        <dt class="col-sm-2">Amount</dt>
        <dd class="col-sm-10">@Model.Amount.ToString("C")</dd>

        <dt class="col-sm-2">Tax Amount</dt>
        <dd class="col-sm-10">@Model.TaxAmount.ToString("C")</dd>

        <dt class="col-sm-2">Total Amount</dt>
        <dd class="col-sm-10">@Model.TotalAmount.ToString("C")</dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.Status</dd>

        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Description</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.InvoiceId" class="btn btn-warning">Edit</a> |
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>