@model SMS.Application.UserRoleDto

@{
    ViewData["Title"] = "Remove Role";
}

<div class="container mt-4">
    <h2>Remove Role from User</h2>

    <div class="alert alert-warning">
        Are you sure you want to remove this role assignment?
    </div>

    <dl class="row">
        <dt class="col-sm-3">User Name</dt>
        <dd class="col-sm-9">@Model.UserName</dd>

        <dt class="col-sm-3">Role Name</dt>
        <dd class="col-sm-9">@Model.RoleName</dd>

        <dt class="col-sm-3">Role Code</dt>
        <dd class="col-sm-9">@Model.RoleCode</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Description</dd>
    </dl>

    <form asp-action="Delete"
          asp-route-id="@Model.UserRoleId"
          method="post">
        @Html.AntiForgeryToken()

        <button type="submit" class="btn btn-danger">
            Confirm Removal
        </button>

        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
