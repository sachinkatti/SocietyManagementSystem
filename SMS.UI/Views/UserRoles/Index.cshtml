@model IEnumerable<SMS.Application.UserRoleDto>

@{
    ViewData["Title"] = "User-Role Management";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>User-Role Management</h2>
        <a asp-action="Create" class="btn btn-primary">Assign Role</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Assignment ID</th>
                    <th>User ID</th>
                    <th>User Name</th>
                    <th>Role</th>
                    <th>Role Code</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.UserRoleId</td>
                            <td>@item.UserId</td>
                            <td>@item.UserName</td>
                            <td>@item.RoleName</td>
                            <td>@item.RoleCode</td>
                            <td>@item.Description</td>
                            <td>@(item.IsActive ? "Active" : "Inactive")</td>
                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@item.UserRoleId"
                                   class="btn btn-info btn-sm">Details</a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.UserRoleId"
                                   class="btn btn-danger btn-sm">Remove</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center">
                            No user-role assignments found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
