@model IEnumerable<SMS.Application.AmenityBookingDto>

@{
    ViewData["Title"] = "Amenity Bookings";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Amenity Bookings</h2>
        <a asp-action="Create" class="btn btn-primary">
            Create Booking
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Tenant</th>
                    <th>Amenity</th>
                    <th>Flat</th>
                    <th>Date</th>
                    <th>Time Slot</th>
                    <th>Deposit</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.BookingId</td>
                            <td>@item.TenantName</td>
                            <td>@item.AmenityName</td>
                            <td>@item.WingName - @item.FlatNumber</td>
                            <td>@item.SlotDate.ToString("dd-MM-yyyy")</td>
                            <td>@item.SlotTime</td>
                            <td>@item.DepositPaid.ToString("N2")</td>
                            <td>@item.Status</td>
                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@item.BookingId"
                                   class="btn btn-info btn-sm">Details</a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.BookingId"
                                   class="btn btn-warning btn-sm">Edit</a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.BookingId"
                                   class="btn btn-danger btn-sm">Delete</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center">
                            No amenity bookings found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>