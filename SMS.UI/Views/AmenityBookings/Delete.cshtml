@model SMS.Application.AmenityBookingDto

@{
    ViewData["Title"] = "Delete Amenity Booking";
}

<div class="container mt-4">
    <h2>Delete Amenity Booking</h2>

    <div class="alert alert-warning mt-3">
        Are you sure you want to delete this booking?
        The booking will be marked inactive.
    </div>

    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Booking ID</dt>
                <dd class="col-sm-9">@Model.BookingId</dd>

                <dt class="col-sm-3">Tenant</dt>
                <dd class="col-sm-9">@Model.TenantName</dd>

                <dt class="col-sm-3">Amenity</dt>
                <dd class="col-sm-9">@Model.AmenityName</dd>

                <dt class="col-sm-3">Flat</dt>
                <dd class="col-sm-9">
                    @Model.WingName - @Model.FlatNumber
                </dd>

                <dt class="col-sm-3">Booking Date</dt>
                <dd class="col-sm-9">
                    @Model.SlotDate.ToString("dd-MM-yyyy")
                </dd>

                <dt class="col-sm-3">Time Slot</dt>
                <dd class="col-sm-9">@Model.SlotTime</dd>

                <dt class="col-sm-3">Deposit Paid</dt>
                <dd class="col-sm-9">
                    @Model.DepositPaid.ToString("N2")
                </dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Status</dd>
            </dl>
        </div>

        <div class="card-footer">
            <form asp-action="Delete"
                  asp-route-id="@Model.BookingId"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-danger">
                    Confirm Delete
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>
