@model SMS.Application.AmenityBookingDto

<h2>Amenity Booking Details</h2>

<dl class="row">
    <dt class="col-sm-3">Booking ID</dt>
    <dd class="col-sm-9">@Model.BookingId</dd>

    <dt class="col-sm-3">Amenity</dt>
    <dd class="col-sm-9">@Model.AmenityName</dd>

    <dt class="col-sm-3">Flat</dt>
    <dd class="col-sm-9">@Model.FlatNumber</dd>

    <dt class="col-sm-3">Slot Date</dt>
    <dd class="col-sm-9">@Model.SlotDate.ToString("dd-MM-yyyy")</dd>

    <dt class="col-sm-3">Slot Time</dt>
    <dd class="col-sm-9">@Model.SlotTime</dd>

    <dt class="col-sm-3">Deposit Paid</dt>
    <dd class="col-sm-9">@Model.DepositPaid.ToString("0.00")</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Description</dd>

    <dt class="col-sm-3">Tenant ID</dt>
    <dd class="col-sm-9">@Model.TenantId</dd>

    <dt class="col-sm-3">Active</dt>
    <dd class="col-sm-9">@(Model.IsActive ? "Yes" : "No")</dd>

    <dt class="col-sm-3">Created On</dt>
    <dd class="col-sm-9">@Model.CreatedOn</dd>

    <dt class="col-sm-3">Created By</dt>
    <dd class="col-sm-9">@Model.CreatedBy</dd>

    <dt class="col-sm-3">Modified On</dt>
    <dd class="col-sm-9">@Model.ModifyOn</dd>

    <dt class="col-sm-3">Modified By</dt>
    <dd class="col-sm-9">@Model.ModifyBy</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.BookingId" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>
