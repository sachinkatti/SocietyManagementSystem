@model SMS.Application.AmenityBookingDto

@{
    ViewData["Title"] = "Amenity Booking Details";
}

<div class="container mt-4">
    <h2>Amenity Booking Details</h2>

    <div class="card mt-3">
        <div class="card-header">
            Booking #@Model.BookingId
        </div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Tenant</dt>
                <dd class="col-sm-9">@Model.TenantName</dd>

                <dt class="col-sm-3">Amenity</dt>
                <dd class="col-sm-9">@Model.AmenityName</dd>

                <dt class="col-sm-3">Wing</dt>
                <dd class="col-sm-9">@Model.WingName</dd>

                <dt class="col-sm-3">Flat Number</dt>
                <dd class="col-sm-9">@Model.FlatNumber</dd>

                <dt class="col-sm-3">Booking Date</dt>
                <dd class="col-sm-9">
                    @Model.SlotDate.ToString("dd-MM-yyyy")
                </dd>

                <dt class="col-sm-3">Time Slot</dt>
                <dd class="col-sm-9">@Model.SlotTime</dd>

                <dt class="col-sm-3">Deposit Paid</dt>
                <dd class="col-sm-9">
                    @Model.DepositPaid.ToString("N2")
                </dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Status</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "N/A"
                        : Model.Description)
                </dd>

                <dt class="col-sm-3">Created On</dt>
                <dd class="col-sm-9">
                    @Model.CreatedOn.ToString("dd-MM-yyyy HH:mm")
                </dd>

                <dt class="col-sm-3">Modified On</dt>
                <dd class="col-sm-9">
                    @(Model.ModifyOn.HasValue
                        ? Model.ModifyOn.Value.ToString("dd-MM-yyyy HH:mm")
                        : "Not modified")
                </dd>
            </dl>
        </div>

        <div class="card-footer">
            <a asp-action="Edit"
               asp-route-id="@Model.BookingId"
               class="btn btn-warning">Edit</a>

            <a asp-action="Index" class="btn btn-secondary">
                Back to List
            </a>
        </div>
    </div>
</div>
