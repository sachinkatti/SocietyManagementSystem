@model SMS.Application.AmenityBookingDto

@{
    ViewData["Title"] = "Create Amenity Booking";
}

<div class="container mt-4">
    <h2>Create Amenity Booking</h2>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="TenantId" class="form-label">Tenant</label>
            <select asp-for="TenantId"
                    asp-items="ViewBag.Tenants"
                    class="form-select"
                    id="TenantId">
                <option value="">-- Select Tenant --</option>
            </select>
            <span asp-validation-for="TenantId"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="AmenityId" class="form-label">Amenity</label>
            <select asp-for="AmenityId"
                    asp-items="ViewBag.Amenities"
                    class="form-select"
                    id="AmenityId">
                <option value="">-- Select Amenity --</option>
            </select>
            <span asp-validation-for="AmenityId"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="FlatId" class="form-label">Flat</label>
            <select asp-for="FlatId"
                    asp-items="ViewBag.Flats"
                    class="form-select"
                    id="FlatId">
                <option value="">-- Select Flat --</option>
            </select>
            <span asp-validation-for="FlatId"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="SlotDate" class="form-label">Booking Date</label>
            <input asp-for="SlotDate" type="date" class="form-control" />
            <span asp-validation-for="SlotDate"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="SlotTime" class="form-label">Time Slot</label>
            <input asp-for="SlotTime"
                   class="form-control"
                   placeholder="Example: 10:00 AM - 12:00 PM" />
            <span asp-validation-for="SlotTime"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DepositPaid" class="form-label"></label>
            <input asp-for="DepositPaid"
                   type="number"
                   min="0"
                   step="0.01"
                   class="form-control" />
            <span asp-validation-for="DepositPaid"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select">
                <option value="Booked">Booked</option>
                <option value="Confirmed">Confirmed</option>
                <option value="Cancelled">Cancelled</option>
                <option value="Completed">Completed</option>
            </select>
            <span asp-validation-for="Status"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description"
                      class="form-control"
                      rows="3"></textarea>
            <span asp-validation-for="Description"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success">Save Booking</button>
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const tenant = document.getElementById("TenantId");
            const amenity = document.getElementById("AmenityId");
            const flat = document.getElementById("FlatId");

            async function loadOptions(url, select, placeholder) {
                select.replaceChildren(new Option(placeholder, ""));

                const response = await fetch(url);

                if (!response.ok) {
                    throw new Error("Unable to load dropdown options.");
                }

                const items = await response.json();

                items.forEach(item => {
                    select.add(new Option(item.text, item.id));
                });
            }

            tenant.addEventListener("change", async function () {
                amenity.replaceChildren(
                    new Option("-- Select Amenity --", ""));
                flat.replaceChildren(
                    new Option("-- Select Flat --", ""));

                if (!tenant.value) return;

                try {
                    await Promise.all([
                        loadOptions(
                            '@Url.Action("GetAmenitiesByTenant")'
                            + '?tenantId=' + encodeURIComponent(tenant.value),
                            amenity,
                            "-- Select Amenity --"
                        ),
                        loadOptions(
                            '@Url.Action("GetFlatsByTenant")'
                            + '?tenantId=' + encodeURIComponent(tenant.value),
                            flat,
                            "-- Select Flat --"
                        )
                    ]);
                } catch (error) {
                    alert(error.message);
                }
            });
        });
    </script>
}
