@model SMS.Application.StaffAttendanceDto

@{
    ViewData["Title"] = "Delete Staff Attendance";
}

<div class="container mt-4">
    <h2>Delete Staff Attendance</h2>

    <div class="alert alert-warning">
        Are you sure you want to delete this attendance record?
        This performs a soft delete, so the database record is retained.
    </div>

    <dl class="row">
        <dt class="col-sm-3">Attendance ID</dt>
        <dd class="col-sm-9">@Model.AttendanceId</dd>

        <dt class="col-sm-3">Staff Name</dt>
        <dd class="col-sm-9">@Model.StaffName</dd>

        <dt class="col-sm-3">Role</dt>
        <dd class="col-sm-9">@Model.StaffRole</dd>

        <dt class="col-sm-3">Society</dt>
        <dd class="col-sm-9">@Model.TenantName</dd>

        <dt class="col-sm-3">Wing</dt>
        <dd class="col-sm-9">@Model.WingName</dd>

        <dt class="col-sm-3">Flat</dt>
        <dd class="col-sm-9">@Model.FlatNumber</dd>

        <dt class="col-sm-3">Check In</dt>
        <dd class="col-sm-9">@Model.CheckInTime.ToString("dd-MM-yyyy hh:mm tt")</dd>
    </dl>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" name="id" value="@Model.AttendanceId" />

        <button type="submit" class="btn btn-danger">
            Confirm Delete
        </button>

        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
