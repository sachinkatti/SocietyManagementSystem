@model SMS.Application.TenantSubscriptionDto

@{
    ViewData["Title"] = "Edit Subscription";
}

<h2>Edit Subscription</h2>

<form asp-action="Edit" asp-route-id="@Model.SubscriptionId" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="SubscriptionId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="TenantId" class="form-label">Tenant ID</label>
        <input asp-for="TenantId" type="number" class="form-control" />
        <span asp-validation-for="TenantId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PlanId" class="form-label">Plan ID</label>
        <input asp-for="PlanId" type="number" class="form-control" />
        <span asp-validation-for="PlanId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="StartDate" class="form-label">Start Date</label>
        <input asp-for="StartDate" type="datetime-local" class="form-control"
               value="@Model.StartDate.ToString("yyyy-MM-ddTHH:mm")" />
        <span asp-validation-for="StartDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EndDate" class="form-label">End Date</label>
        <input asp-for="EndDate" type="datetime-local" class="form-control"
               value="@Model.EndDate.ToString("yyyy-MM-ddTHH:mm")" />
        <span asp-validation-for="EndDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" class="form-select">
            <option value="Active">Active</option>
            <option value="Pending">Pending</option>
            <option value="Expired">Expired</option>
            <option value="Cancelled">Cancelled</option>
        </select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="AmountPaid" class="form-label"></label>
        <input asp-for="AmountPaid" type="number" step="0.01" min="0" class="form-control" />
        <span asp-validation-for="AmountPaid" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PaymentReference" class="form-label"></label>
        <input asp-for="PaymentReference" class="form-control" maxlength="100" />
        <span asp-validation-for="PaymentReference" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" maxlength="500"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Update</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}