@model SMS.Application.TenantSubscriptionDto

@{
    ViewData["Title"] = "Subscription Details";
}

<h2>Subscription Details</h2>

<dl class="row">
    <dt class="col-sm-3">Subscription ID</dt>
    <dd class="col-sm-9">@Model.SubscriptionId</dd>

    <dt class="col-sm-3">Tenant ID</dt>
    <dd class="col-sm-9">@Model.TenantId</dd>

    <dt class="col-sm-3">Plan ID</dt>
    <dd class="col-sm-9">@Model.PlanId</dd>

    <dt class="col-sm-3">Start Date</dt>
    <dd class="col-sm-9">@Model.StartDate.ToString("dd-MM-yyyy HH:mm")</dd>

    <dt class="col-sm-3">End Date</dt>
    <dd class="col-sm-9">@Model.EndDate.ToString("dd-MM-yyyy HH:mm")</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>

    <dt class="col-sm-3">Amount Paid</dt>
    <dd class="col-sm-9">@Model.AmountPaid.ToString("N2")</dd>

    <dt class="col-sm-3">Payment Reference</dt>
    <dd class="col-sm-9">@Model.PaymentReference</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Description</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.SubscriptionId" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>