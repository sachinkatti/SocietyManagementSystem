@model SMS.Application.RoleDto

@{
    ViewData["Title"] = "Create Role";
}

<div class="container mt-4">
    <h2>Create Role</h2>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="TenantId" class="form-label">Tenant</label>
            <select asp-for="TenantId" asp-items="ViewBag.Tenants" class="form-select">
                <option value="">-- Select Tenant --</option>
            </select>
            <span asp-validation-for="TenantId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="RoleName" class="form-label"></label>
            <input asp-for="RoleName" class="form-control" />
            <span asp-validation-for="RoleName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="RoleCode" class="form-label"></label>
            <input asp-for="RoleCode" class="form-control" />
            <span asp-validation-for="RoleCode" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="RoleDescription" class="form-label">Description</label>
            <textarea asp-for="RoleDescription" class="form-control"></textarea>
            <span asp-validation-for="RoleDescription" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
