@model IEnumerable<SMS.Application.RoleDto>

@{
    ViewData["Title"] = "Role Management";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Role Management</h2>
        <a asp-action="Create" class="btn btn-primary">Create Role</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Role ID</th>
                    <th>Tenant ID</th>
                    <th>Role Name</th>
                    <th>Role Code</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var role in Model)
                    {
                        <tr>
                            <td>@role.RoleId</td>
                            <td>@role.TenantId</td>
                            <td>@role.RoleName</td>
                            <td>@role.RoleCode</td>
                            <td>@role.RoleDescription</td>
                            <td>@(role.IsActive ? "Active" : "Inactive")</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@role.RoleId"
                                   class="btn btn-info btn-sm">Details</a>
                                <a asp-action="Edit" asp-route-id="@role.RoleId"
                                   class="btn btn-warning btn-sm">Edit</a>
                                <a asp-action="Delete" asp-route-id="@role.RoleId"
                                   class="btn btn-danger btn-sm">Deactivate</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center">No roles found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
