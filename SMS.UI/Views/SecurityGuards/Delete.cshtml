@model SMS.Application.SecurityGuardDto

@{
    ViewData["Title"] = "Delete Security Guard";
}

<h2>Delete Security Guard</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this security guard?
    The record will be deactivated rather than permanently removed.
</div>

<dl class="row">
    <dt class="col-sm-3">Guard ID</dt>
    <dd class="col-sm-9">@Model.GuardId</dd>

    <dt class="col-sm-3">User</dt>
    <dd class="col-sm-9">@Model.FullName</dd>

    <dt class="col-sm-3">Shift Timing</dt>
    <dd class="col-sm-9">@Model.ShiftTiming</dd>

    <dt class="col-sm-3">Assigned Gate</dt>
    <dd class="col-sm-9">@(Model.AssignedGate ?? "-")</dd>

    <dt class="col-sm-3">Joining Date</dt>
    <dd class="col-sm-9">@Model.JoiningDate.ToString("dd-MM-yyyy")</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.GuardId" method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>