@model SMS.Application.DistrictDto

@{
    ViewData["Title"] = "Edit District";
}

<div class="container mt-4">
    <h2>Edit District</h2>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="DistrictId" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="StateId"
                   class="form-label">
                State
            </label>

            <select asp-for="StateId"
                    asp-items="ViewBag.States"
                    class="form-select">
                <option value="">-- Select State --</option>
            </select>

            <span asp-validation-for="StateId"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DistrictName"
                   class="form-label">
                District Name
            </label>

            <input asp-for="DistrictName"
                   class="form-control" />

            <span asp-validation-for="DistrictName"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DistrictCode"
                   class="form-label">
                District Code
            </label>

            <input asp-for="DistrictCode"
                   class="form-control" />

            <span asp-validation-for="DistrictCode"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description"
                   class="form-label">
                Description
            </label>

            <textarea asp-for="Description"
                      class="form-control"></textarea>

            <span asp-validation-for="Description"
                  class="text-danger"></span>
        </div>

        <div class="form-check mb-3">
            <input asp-for="IsActive"
                   class="form-check-input" />

            <label asp-for="IsActive"
                   class="form-check-label">
                Active
            </label>
        </div>

        <button type="submit"
                class="btn btn-primary">
            Update
        </button>

        <a asp-action="Index"
               class="btn btn-secondary">
            Back
        </a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}