@model SMS.Application.DistrictDto

@{
    ViewData["Title"] = "District Details";
}

<div class="container mt-4">
    <h2>District Details</h2>

    <dl class="row">
        <dt class="col-sm-3">District ID</dt>
        <dd class="col-sm-9">@Model.DistrictId</dd>

        <dt class="col-sm-3">State</dt>
        <dd class="col-sm-9">@Model.StateName</dd>

        <dt class="col-sm-3">District Name</dt>
        <dd class="col-sm-9">@Model.DistrictName</dd>

        <dt class="col-sm-3">District Code</dt>
        <dd class="col-sm-9">@Model.DistrictCode</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Description</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">
            @(Model.IsActive ? "Active" : "Inactive")
        </dd>

        <dt class="col-sm-3">Created On</dt>
        <dd class="col-sm-9">@Model.CreatedOn</dd>

        <dt class="col-sm-3">Created By</dt>
        <dd class="col-sm-9">@Model.CreatedBy</dd>

        <dt class="col-sm-3">Modified On</dt>
        <dd class="col-sm-9">@Model.ModifyOn</dd>

        <dt class="col-sm-3">Modified By</dt>
        <dd class="col-sm-9">@Model.ModifyBy</dd>
    </dl>

    <a asp-action="Edit"
           asp-route-id="@Model.DistrictId"
           class="btn btn-warning">
        Edit
    </a>

    <a asp-action="Index"
           class="btn btn-secondary">
        Back
    </a>
</div>