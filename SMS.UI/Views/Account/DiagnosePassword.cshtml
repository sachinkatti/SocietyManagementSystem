@{
    ViewData["Title"] = "Password Diagnostic";
}

<h2>Verify Existing Password</h2>

<form asp-controller="Account"
      asp-action="DiagnosePassword"
      method="post">
    @Html.AntiForgeryToken()

    <div>
        <label for="password">Password you created</label>
        <input type="password"
               id="password"
               name="password"
               required />
    </div>

    <button type="submit">Verify Password</button>
</form>