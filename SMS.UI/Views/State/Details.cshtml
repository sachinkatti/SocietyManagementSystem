@model SMS.Application.StateDto

@{
    ViewData["Title"] = "State Details";
}

<div class="container mt-4">
    <h2>State Details</h2>

    <dl class="row">
        <dt class="col-sm-3">State ID</dt>
        <dd class="col-sm-9">@Model.StateId</dd>

        <dt class="col-sm-3">Country</dt>
        <dd class="col-sm-9">@Model.CountryName</dd>

        <dt class="col-sm-3">State Name</dt>
        <dd class="col-sm-9">@Model.StateName</dd>

        <dt class="col-sm-3">State Code</dt>
        <dd class="col-sm-9">@Model.StateCode</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">
            @(Model.IsActive ? "Active" : "Inactive")
        </dd>

        <dt class="col-sm-3">Created On</dt>
        <dd class="col-sm-9">@Model.CreatedOn</dd>

        <dt class="col-sm-3">Created By</dt>
        <dd class="col-sm-9">@Model.CreatedBy</dd>

        <dt class="col-sm-3">Modified On</dt>
        <dd class="col-sm-9">@Model.ModifyOn</dd>

        <dt class="col-sm-3">Modified By</dt>
        <dd class="col-sm-9">@Model.ModifyBy</dd>
    </dl>

    <a asp-action="Edit"
           asp-route-id="@Model.StateId"
           class="btn btn-warning">
        Edit
    </a>

    <a asp-action="Index"
           class="btn btn-secondary">
        Back
    </a>
</div>