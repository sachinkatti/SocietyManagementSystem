@model SMS.Application.CityDto

@{
    ViewData["Title"] = "City Details";
}

<div class="container mt-4">
    <h2>City Details</h2>

    <dl class="row">
        <dt class="col-sm-3">City ID</dt>
        <dd class="col-sm-9">@Model.CityId</dd>

        <dt class="col-sm-3">Taluk</dt>
        <dd class="col-sm-9">@Model.TalukName</dd>

        <dt class="col-sm-3">City Name</dt>
        <dd class="col-sm-9">@Model.CityName</dd>

        <dt class="col-sm-3">City Code</dt>
        <dd class="col-sm-9">@Model.CityCode</dd>

        <dt class="col-sm-3">Postal Code</dt>
        <dd class="col-sm-9">@Model.PostalCode</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Description</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">
            @(Model.IsActive ? "Active" : "Inactive")
        </dd>

        <dt class="col-sm-3">Created On</dt>
        <dd class="col-sm-9">@Model.CreatedOn</dd>

        <dt class="col-sm-3">Created By</dt>
        <dd class="col-sm-9">@Model.CreatedBy</dd>

        <dt class="col-sm-3">Modified On</dt>
        <dd class="col-sm-9">@Model.ModifyOn</dd>

        <dt class="col-sm-3">Modified By</dt>
        <dd class="col-sm-9">@Model.ModifyBy</dd>
    </dl>

    <a asp-action="Edit"
           asp-route-id="@Model.CityId"
           class="btn btn-warning">
        Edit
    </a>

    <a asp-action="Index"
           class="btn btn-secondary">
        Back
    </a>
</div>