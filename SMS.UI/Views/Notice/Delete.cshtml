@model SMS.Application.NoticeDto

@{
    ViewData["Title"] = "Delete Notice";
}

<h2>Delete Notice</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this notice? It will be deactivated,
    not permanently removed from the database.
</div>

<dl class="row">
    <dt class="col-sm-3">Notice ID</dt>
    <dd class="col-sm-9">@Model.NoticeId</dd>

    <dt class="col-sm-3">Title</dt>
    <dd class="col-sm-9">@Model.Title</dd>

    <dt class="col-sm-3">Category</dt>
    <dd class="col-sm-9">@Model.Category</dd>

    <dt class="col-sm-3">Tenant</dt>
    <dd class="col-sm-9">@Model.TenantName</dd>

    <dt class="col-sm-3">Publish Date</dt>
    <dd class="col-sm-9">@Model.PublishDate.ToString("dd-MM-yyyy HH:mm")</dd>
</dl>

<form asp-action="Delete"
      asp-route-id="@Model.NoticeId"
      method="post">
    @Html.AntiForgeryToken()

    <button type="submit" class="btn btn-danger">
        Confirm Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>