@model SMS.Application.PlanFeatureDto

@{
    ViewData["Title"] = "Create Plan Feature";
}

<h2>Add Feature to Plan</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="PlanId" class="form-label">Plan</label>
        <select asp-for="PlanId" asp-items="ViewBag.Plans" class="form-select">
            <option value="0">Select Plan</option>
        </select>
        <span asp-validation-for="PlanId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FeatureId" class="form-label">Feature</label>
        <select asp-for="FeatureId" asp-items="ViewBag.Features" class="form-select">
            <option value="0">Select Feature</option>
        </select>
        <span asp-validation-for="FeatureId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FeatureValue" class="form-label"></label>
        <input asp-for="FeatureValue" class="form-control" />
        <span asp-validation-for="FeatureValue" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Mapping</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
