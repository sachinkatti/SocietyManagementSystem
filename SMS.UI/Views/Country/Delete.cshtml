@model SMS.Application.CountryDto

@{
    ViewData["Title"] = "Delete Country";
}

<div class="container mt-4">

    <h2>Delete Country</h2>

    <div class="alert alert-danger">
        Are you sure you want to delete this country?
    </div>

    <dl class="row">

        <dt class="col-sm-3">
            Country ID
        </dt>

        <dd class="col-sm-9">
            @Model.CountryId
        </dd>

        <dt class="col-sm-3">
            Region
        </dt>

        <dd class="col-sm-9">
            @Model.RegionName
        </dd>

        <dt class="col-sm-3">
            Country Name
        </dt>

        <dd class="col-sm-9">
            @Model.CountryName
        </dd>

        <dt class="col-sm-3">
            Country Code
        </dt>

        <dd class="col-sm-9">
            @Model.CountryCode
        </dd>

        <dt class="col-sm-3">
            Description
        </dt>

        <dd class="col-sm-9">
            @Model.Description
        </dd>

    </dl>

    <form asp-action="DeleteConfirmed"
          method="post">

        <input type="hidden"
               name="countryId"
               value="@Model.CountryId" />

        <button type="submit"
                class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index"
               class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>