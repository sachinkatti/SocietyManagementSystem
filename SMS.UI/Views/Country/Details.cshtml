@model SMS.Application.CountryDto

@{
    ViewData["Title"] = "Country Details";
}

<div class="container mt-4">

    <h2>Country Details</h2>

    <dl class="row">

        <dt class="col-sm-3">
            Country ID
        </dt>

        <dd class="col-sm-9">
            @Model.CountryId
        </dd>

        <dt class="col-sm-3">
            Region
        </dt>

        <dd class="col-sm-9">
            @Model.RegionName
        </dd>

        <dt class="col-sm-3">
            Country Name
        </dt>

        <dd class="col-sm-9">
            @Model.CountryName
        </dd>

        <dt class="col-sm-3">
            Country Code
        </dt>

        <dd class="col-sm-9">
            @Model.CountryCode
        </dd>

        <dt class="col-sm-3">
            Description
        </dt>

        <dd class="col-sm-9">
            @Model.Description
        </dd>

        <dt class="col-sm-3">
            Status
        </dt>

        <dd class="col-sm-9">

            @if (Model.IsActive)
            {
                <span class="badge bg-success">
                    Active
                </span>
            }
            else
            {
                <span class="badge bg-danger">
                    Inactive
                </span>
            }

        </dd>

        <dt class="col-sm-3">
            Created On
        </dt>

        <dd class="col-sm-9">
            @Model.CreatedOn
        </dd>

        <dt class="col-sm-3">
            Created By
        </dt>

        <dd class="col-sm-9">
            @Model.CreatedBy
        </dd>

        <dt class="col-sm-3">
            Modified On
        </dt>

        <dd class="col-sm-9">
            @Model.ModifyOn
        </dd>

        <dt class="col-sm-3">
            Modified By
        </dt>

        <dd class="col-sm-9">
            @Model.ModifyBy
        </dd>

    </dl>

    <a asp-action="Edit"
           asp-route-id="@Model.CountryId"
           class="btn btn-warning">
        Edit
    </a>

    <a asp-action="Index"
           class="btn btn-secondary">
        Back
    </a>

</div>