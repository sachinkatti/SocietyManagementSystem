@model SMS.Application.AdminDto

@{
    ViewData["Title"] = "Admin Details";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Admin Details</h2>
        <a asp-controller="Admin" asp-action="Index"
           class="btn btn-secondary">Back to List</a>
    </div>

    <hr />

    <div class="card shadow-sm">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Admin ID</dt>
                <dd class="col-sm-9">@Model.AdminId</dd>

                <dt class="col-sm-3">User ID</dt>
                <dd class="col-sm-9">@Model.UserId</dd>

                <dt class="col-sm-3">Tenant ID</dt>
                <dd class="col-sm-9">@Model.TenantId</dd>

                <dt class="col-sm-3">First Name</dt>
                <dd class="col-sm-9">@Model.FirstName</dd>

                <dt class="col-sm-3">Middle Name</dt>
                <dd class="col-sm-9">@Model.MiddleName</dd>

                <dt class="col-sm-3">Last Name</dt>
                <dd class="col-sm-9">@Model.LastName</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">Phone Number</dt>
                <dd class="col-sm-9">@Model.PhoneNumber</dd>

                <dt class="col-sm-3">Designation</dt>
                <dd class="col-sm-9">@Model.Designation</dd>

                <dt class="col-sm-3">Contact Number</dt>
                <dd class="col-sm-9">@Model.ContactNumber</dd>

                <dt class="col-sm-3">Date Assigned</dt>
                <dd class="col-sm-9">
                    @Model.DateAssigned.ToString("dd-MM-yyyy")
                </dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @(Model.IsActive ? "Active" : "Inactive")
                </dd>

                <dt class="col-sm-3">Created On</dt>
                <dd class="col-sm-9">@Model.CreatedOn</dd>

                <dt class="col-sm-3">Created By</dt>
                <dd class="col-sm-9">@Model.CreatedBy</dd>

                <dt class="col-sm-3">Modified On</dt>
                <dd class="col-sm-9">@Model.ModifyOn</dd>

                <dt class="col-sm-3">Modified By</dt>
                <dd class="col-sm-9">@Model.ModifyBy</dd>
            </dl>

            <a asp-controller="Admin" asp-action="Edit"
               asp-route-id="@Model.AdminId"
               class="btn btn-warning">Edit</a>

            <a asp-controller="Admin" asp-action="Index"
               class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>