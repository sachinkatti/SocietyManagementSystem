@model SMS.Application.FlatDto

@{
    ViewData["Title"] = "Flat Details";
}

<div class="container mt-4">
    <h2>Flat Details</h2>

    <dl class="row">
        <dt class="col-sm-3">Flat ID</dt>
        <dd class="col-sm-9">@Model.FlatId</dd>

        <dt class="col-sm-3">Wing ID</dt>
        <dd class="col-sm-9">@Model.WingId</dd>

        <dt class="col-sm-3">Flat Number</dt>
        <dd class="col-sm-9">@Model.FlatNumber</dd>

        <dt class="col-sm-3">Floor Number</dt>
        <dd class="col-sm-9">@Model.FloorNumber</dd>

        <dt class="col-sm-3">Square Feet</dt>
        <dd class="col-sm-9">@Model.SquareFeet</dd>

        <dt class="col-sm-3">Occupancy Status</dt>
        <dd class="col-sm-9">@Model.OccupancyStatus</dd>

        <dt class="col-sm-3">Parking Slot</dt>
        <dd class="col-sm-9">@(Model.ParkingSlotNumber ?? "N/A")</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@(Model.Description ?? "N/A")</dd>

        <dt class="col-sm-3">Created On</dt>
        <dd class="col-sm-9">@Model.CreatedOn.ToString("dd-MM-yyyy HH:mm")</dd>

        <dt class="col-sm-3">Created By</dt>
        <dd class="col-sm-9">@(Model.CreatedBy?.ToString() ?? "N/A")</dd>

        <dt class="col-sm-3">Last Modified</dt>
        <dd class="col-sm-9">@(Model.ModifyOn?.ToString("dd-MM-yyyy HH:mm") ?? "Not modified")</dd>

        <dt class="col-sm-3">Modified By</dt>
        <dd class="col-sm-9">@(Model.ModifyBy?.ToString() ?? "N/A")</dd>
    </dl>

    <a asp-action="Edit" asp-route-id="@Model.FlatId" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</div>