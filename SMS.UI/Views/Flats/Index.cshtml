
@model IEnumerable<SMS.Application.FlatDto>

@{
    ViewData["Title"] = "Flats";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Flats</h2>
        <a asp-action="Create" class="btn btn-primary">Add Flat</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Flat ID</th>
                    <th>Wing ID</th>
                    <th>Flat Number</th>
                    <th>Floor</th>
                    <th>Square Feet</th>
                    <th>Occupancy Status</th>
                    <th>Parking Slot</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var flat in Model)
                {
                    <tr>
                        <td>@flat.FlatId</td>
                        <td>@flat.WingId</td>
                        <td>@flat.FlatNumber</td>
                        <td>@flat.FloorNumber</td>
                        <td>@flat.SquareFeet</td>
                        <td>@flat.OccupancyStatus</td>
                        <td>@(flat.ParkingSlotNumber ?? "N/A")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@flat.FlatId"
                               class="btn btn-info btn-sm">Details</a>
                            <a asp-action="Edit" asp-route-id="@flat.FlatId"
                               class="btn btn-warning btn-sm">Edit</a>
                            <a asp-action="Delete" asp-route-id="@flat.FlatId"
                               class="btn btn-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>